{
  "configVersion": "v3",
  "app": {
    "appId": 27212,
    "appName": "SystemInfo",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "Jan",
